# API base URL (default: /api)
VITE_API_BASE_URL=/api

# App branding (displayed in login page, sidebar, metadata)
VITE_APP_NAME=Soutenances
VITE_APP_SUBTITLE=Planification des Soutenances
VITE_APP_DESCRIPTION=Plateforme de planification et suivi des soutenances universitaires.

# Institution info
VITE_APP_INSTITUTION=Faculté des Sciences Ben M'Sik

# Email domain for placeholders (e.g. nom.prenom@domain)
VITE_APP_EMAIL_DOMAIN=univh2c.ma

# Support contact
VITE_APP_SUPPORT_EMAIL=support@univh2c.ma

# Logo path (served from public/)
VITE_APP_LOGO=/logo.svg

# GitHub repository URL
VITE_APP_GITHUB=https://github.com/abdelaziz-ebourki/system-gestion-soutenance-ui
